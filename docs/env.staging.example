# --- Plantilla .env para STAGING (sin secretos) ---
# Copiar a la raíz del proyecto como .env y rellenar los valores reales.
# No commitear .env.

APP_NAME="Financiera Staging"
APP_ENV=staging
APP_KEY=base64:REEMPLAZAR-CON-php-artisan-key-generate
APP_DEBUG=false
APP_URL=https://api-staging.ejemplo.com

# Frontend (CORS). Si no hay frontend en staging, puede ser un placeholder.
FRONTEND_URL=https://app-staging.ejemplo.com
# CORS_ALLOWED_ORIGINS=https://app-staging.ejemplo.com

# DB: usar BD y credenciales propias de staging
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=financiera_staging
DB_USERNAME=your_staging_db_user
DB_PASSWORD=your_staging_db_password

# Logs
LOG_CHANNEL=daily
LOG_LEVEL=debug

# Storage: local para staging típico. Si usas S3, ver env.production.example
FILESYSTEM_DRIVER=local

# Mail: log evita enviar correos reales
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@staging.ejemplo.com
MAIL_FROM_NAME="${APP_NAME}"

# Cache / Queue / Session
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

# Sanctum: con API Bearer normalmente no hace falta. Opcional si usas cookies stateful.
# SANCTUM_STATEFUL_DOMAINS=api-staging.ejemplo.com,app-staging.ejemplo.com

# Swagger: habilitar documentación API en staging
SWAGGER_ENABLED=true
SWAGGER_URL=/docs
L5_SWAGGER_GENERATE_ALWAYS=false
