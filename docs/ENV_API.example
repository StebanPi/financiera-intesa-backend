# --- Variables para la API y Next.js (añadir a .env) ---

# URL del frontend. Requerido en staging/prod para CORS en /api/*. En local: http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Opcional: varios orígenes CORS (lista separada por comas). Tiene prioridad; FRONTEND_URL se añade si falta.
# FRONTEND_URLS=https://app.ejemplo.com,https://staging.tu-dominio.com

# Opcional: orígenes CORS. Si no se usan FRONTEND_URLS ni esto, se usa FRONTEND_URL.
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://app.ejemplo.com

# Opcional: para tests con MySQL (algunas migraciones no son compatibles con SQLite)
# DB_CONNECTION=mysql
# DB_DATABASE=financiera_intesa_test
