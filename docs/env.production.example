# --- Plantilla .env para PRODUCCIÓN (sin secretos) ---
# Copiar a la raíz del proyecto como .env y rellenar los valores reales.
# No commitear .env.

APP_NAME="Financiera"
APP_ENV=production
APP_KEY=base64:REEMPLAZAR-CON-php-artisan-key-generate
APP_DEBUG=false
APP_URL=https://api.ejemplo.com

# Frontend (CORS)
FRONTEND_URL=https://app.ejemplo.com
# CORS_ALLOWED_ORIGINS=https://app.ejemplo.com

# DB: usar BD y credenciales propias de producción
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=financiera_production
DB_USERNAME=your_production_db_user
DB_PASSWORD=your_production_db_password

# Logs
LOG_CHANNEL=daily
LOG_LEVEL=warning

# Storage: local o s3. Si s3, definir AWS_* más abajo.
FILESYSTEM_DRIVER=local

# Mail: SMTP o servicio (SES, Mailgun, Postmark, etc.)
MAIL_MAILER=smtp
MAIL_HOST=your-smtp-host
MAIL_PORT=587
MAIL_USERNAME=your-smtp-user
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@ejemplo.com
MAIL_FROM_NAME="${APP_NAME}"

# Cache / Queue / Session (en prod a menudo redis o database)
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file

# Sanctum: con API Bearer normalmente no hace falta.
# SANCTUM_STATEFUL_DOMAINS=api.ejemplo.com,app.ejemplo.com

# Swagger: deshabilitado en producción por defecto
SWAGGER_ENABLED=true
SWAGGER_URL=/docs
L5_SWAGGER_GENERATE_ALWAYS=false

# --- Solo si FILESYSTEM_DRIVER=s3 ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=your-bucket
# AWS_URL=https://your-bucket.s3.region.amazonaws.com
# AWS_ENDPOINT=
# AWS_USE_PATH_STYLE_ENDPOINT=false
